# ── Generated secrets (written by scripts/gen-secrets.sh) ──────────────────────
# JWT_SECRET must be ≥32 characters
JWT_SECRET=
# SHARE_ENCRYPTION_KEY must be exactly 64 hex chars (32 bytes)
SHARE_ENCRYPTION_KEY=
# Single hex password used for postgres + all three service DB connections
POSTGRES_PASSWORD=
AUTH_SERVICE_DB_PASS=
HOT_STORAGE_DB_PASS=
COLD_STORAGE_DB_PASS=

# ── Google OAuth (optional — email/password fallback stays enabled) ─────────────
# Google Cloud Console → Credentials → OAuth 2.0 Client ID → Web application
#   Authorized JS origin:    http://localhost:7060
#   Authorized redirect URI: http://localhost:7052/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Shield (cold storage) — written by scripts/bootstrap-shield.ts ─────────────
SHIELD_API_KEY=
SHIELD_API_SECRET=
SHIELD_ENCRYPTION_PART=
# Public key echoed to the client (iframe reads it; not secret)
NEXT_PUBLIC_SHIELD_API_KEY=

# ── Service URLs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_AUTH_URL=http://localhost:7052
NEXT_PUBLIC_HOT_STORAGE_URL=http://localhost:7054
NEXT_PUBLIC_COLD_STORAGE_URL=http://localhost:7053
NEXT_PUBLIC_IFRAME_URL=http://localhost:7050/index.html?debug=true

# ── Web app networks (copy these to web/.env.local) ──────────────────────────────
# One Pimlico key routes to Ethereum, Base and Arbitrum mainnets and Sepolia testnets.
NEXT_PUBLIC_PIMLICO_API_KEY=
# Optional overrides: ETHEREUM, SEPOLIA, BASE, BASE_SEPOLIA, ARBITRUM, ARBITRUM_SEPOLIA
# NEXT_PUBLIC_RPC_URL_BASE=https://YOUR_BASE_RPC
# NEXT_PUBLIC_PIMLICO_URL_BASE=https://YOUR_BASE_BUNDLER_RPC
# Legacy NEXT_PUBLIC_PIMLICO_URL remains supported (see README).
